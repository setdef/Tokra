<h1>Verification Test</h1>

<div class="message-block">
  <div class="message-label">Message from Ruby</div>
  <div class="message-content"><%= message %></div>
</div>

<div class="field">
  <label for="response">Your response</label>
  <input type="text" id="response" name="response" autocomplete="off">
</div>

<div class="actions">
  <button data-primary id="btn-ipc">Send via IPC</button>
  <button id="btn-form">Submit form</button>
  <button id="btn-fetch">POST to API</button>
</div>

<div class="feedback" id="feedback"></div>

<pre id="log" style="white-space:pre-wrap;font-size:12px;opacity:.75;margin-top:1rem"></pre>

<% if flash["success"] %>
<div class="feedback" data-visible data-type="success"><%= flash["success"] %></div>
<% end %>

<div class="ipc-indicator" id="ipc-status">IPC available</div>

<script>
  const responseInput = document.getElementById('response');
  const feedback = document.getElementById('feedback');
  const ipcStatus = document.getElementById('ipc-status');
  const logEl = document.getElementById('log');

  function showFeedback(message, type) {
    feedback.textContent = message;
    feedback.setAttribute('data-type', type);
    feedback.setAttribute('data-visible', '');
  }

  // Mirror the flow to an on-page log and the console, so the round trip is
  // observable even without DevTools open.
  function logLine(message) {
    console.log('[ipc]', message);
    logEl.textContent += message + '\n';
  }

  logLine('page loaded; window.__TAURI__ present? ' + !!window.__TAURI__);
  window.addEventListener('error', (e) => logLine('window error: ' + e.message));

  // IPC — a real invoke() round-trip through the vendored @tauri-apps/api
  // (window.__TAURI__.core.invoke), exactly how a bundler-less Tauri app
  // invokes. It rides the ipc:// custom-protocol transport; the Ruby
  // invoke_handler resolves the promise and we render the value.
  document.getElementById('btn-ipc').addEventListener('click', async () => {
    const value = responseInput.value;
    logLine('button clicked');
    showFeedback('IPC: sending…', 'pending');

    const invoke = window.__TAURI__ && window.__TAURI__.core && window.__TAURI__.core.invoke;
    logLine('invoke fn typeof = ' + typeof invoke);
    if (!invoke) {
      showFeedback('IPC not available (window.__TAURI__.core.invoke missing)', 'error');
      return;
    }

    try {
      const reply = await invoke('ping', { message: value });
      logLine('resolved: ' + JSON.stringify(reply));
      showFeedback('IPC round-trip: ' + reply, 'success');
    } catch (err) {
      logLine('rejected: ' + err);
      showFeedback('IPC error: ' + err, 'error');
    }
  });

  // Form submit
  document.getElementById('btn-form').addEventListener('click', () => {
    const value = responseInput.value;
    showFeedback('Submitting form...', 'pending');

    const form = document.createElement('form');
    form.method = 'POST';
    form.action = 'tokra://localhost/submit';
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'response';
    input.value = value;
    form.appendChild(input);
    document.body.appendChild(form);
    form.submit();
  });

  // Fetch API
  document.getElementById('btn-fetch').addEventListener('click', async () => {
    const value = responseInput.value;
    showFeedback('Sending request...', 'pending');

    try {
      const response = await fetch('tokra://localhost/api', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: value })
      });
      const data = await response.json();
      showFeedback('Response: ' + JSON.stringify(data), 'success');
    } catch (err) {
      showFeedback('Request failed: ' + err.message, 'error');
    }
  });

  // IPC availability
  if (!(window.__TAURI__ && window.__TAURI__.core && window.__TAURI__.core.invoke)) {
    ipcStatus.textContent = 'IPC unavailable';
    ipcStatus.style.setProperty('--accent', 'var(--warn)');
  }
</script>
