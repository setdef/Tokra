source "https://rubygems.org"

gemspec

gem "tokra", path: "../.."
# tokra reads its config's URLs with ferro-url, which is not on
# RubyGems.org yet, so Bundler takes it from its release tag (ADR 011).
gem "ferro-url", git: "https://github.com/setdef/Ferro", tag: "ferro-url/v0.1.0", glob: "gems/url/*.gemspec"

# ferro-global-hotkey is not on RubyGems.org yet, so Bundler takes it from
# Ferro's repository (ADR 011), at its release tag (Plan 025).
gem "ferro-global-hotkey", git: "https://github.com/setdef/Ferro", tag: "ferro-global-hotkey/v0.1.0",
  glob: "gems/global-hotkey/*.gemspec"

group :development, :test do
  # RealApp watches the frontmost app through AppKit while the window
  # test runs (test/integration/support/frontmost.rb).
  gem "fiddle"
  gem "minitest"
  gem "minitest-mock"
  gem "rake"
end
