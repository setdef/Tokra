source "https://rubygems.org"

gemspec

gem "tokra", path: "../.."
# tokra reads its config's URLs with ferro-url, and tokra-log formats its
# timestamps with ferro-time. Neither is on RubyGems.org yet, so Bundler
# takes each from its release tag (ADR 011, Plan 065).
gem "ferro-url", git: "https://github.com/setdef/Ferro", tag: "ferro-url/v0.1.0", glob: "gems/url/*.gemspec"
gem "ferro-time", git: "https://github.com/setdef/Ferro", tag: "ferro-time/v0.1.0", glob: "gems/time/*.gemspec"

group :development, :test do
  # The tests hand the plugin a Logger of their own (TargetKind::Dispatch).
  gem "logger"
  gem "minitest"
  gem "minitest-mock"
  gem "rake"
end
