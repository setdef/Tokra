module Tokra
  module Plugins
    module Log
      type level = :error | :warn | :info | :debug | :trace
      type level_filter = :off | level
      type format = ^(String message, Record record) -> String?
      type filter = ^(Metadata metadata) -> boolish
      type kind = TargetKind::Stdout | TargetKind::Stderr | TargetKind::Folder | TargetKind::LogDir
                | TargetKind::Webview | TargetKind::Dispatch
      type rotation = RotationStrategy::KeepAll | RotationStrategy::KeepOne | RotationStrategy::KeepSome
      type timezone = TimezoneStrategy::UseUtc | TimezoneStrategy::UseLocal
      type output = Output::Stream | Output::Writer | Output::Webview | Output::Dispatch

      interface _Logger
        def add: (Integer severity, String message, String progname) -> void
      end

      TRACE: Integer
      WEBVIEW_TARGET: String
      DEFAULT_MAX_FILE_SIZE: Integer
      DEFAULT_ROTATION_STRATEGY: RotationStrategy::KeepOne
      DEFAULT_TIMEZONE_STRATEGY: TimezoneStrategy::UseUtc
      LOG_DATE_FORMAT: Ferro::Time::FormatDescription::description

      class Plugin < Tokra::Plugin
        SEVERITY_LEVELS: Hash[Integer, level]
        LEVEL_FILTERS: Array[level_filter]
        U16: Range[Integer]

        @max_level: Integer
        @filters: Array[filter]
        @format: format?
        @app_name: String
        @targets: Array[[Array[filter], format?, output]]

        def name: () -> String
        def initialize: (Builder builder) -> void
        def initialize_plugin: (Tokra::AppHandle app, Tokra::json_value config) -> nil
        def trace: (?Object? progname) ?{ () -> Object } -> true
        def debug: (?Object? progname) ?{ () -> Object } -> true
        def info: (?Object? progname) ?{ () -> Object } -> true
        def warn: (?Object? progname) ?{ () -> Object } -> true
        def error: (?Object? progname) ?{ () -> Object } -> true
        def fatal: (?Object? progname) ?{ () -> Object } -> true
        def add: (Integer? severity, ?Object? message, ?Object? progname) ?{ () -> Object } -> true
        def extend_api: (Tokra::Ipc::Invoke invoke) -> bool

        private

        def argument: (Tokra::Ipc::Invoke invoke, String key) -> Tokra::Ipc::CommandItem
        def log_level_arg: (Tokra::Ipc::Invoke invoke) -> level
        def optional_str_arg: (Tokra::Ipc::Invoke invoke, String key) -> String?
        def key_values_arg: (Tokra::Ipc::Invoke invoke) -> Hash[String, String]?

        def dispatch: (Record record) -> void
        def finish: (Record record, format? format) -> Record
        def level_of: (Integer? severity) -> level
        def message_text: (Object? message) -> String
        def output: (kind kind, Builder builder) -> output
        def file_output: (String | Pathname dir, String? file_name, Builder builder) -> Output::Writer
        def log_dir: (Builder builder) -> Pathname
        def handle_for: (String kind, Builder builder) -> Tokra::AppHandle
      end

      class Builder
        TIMESTAMP: Ferro::Time::FormatDescription::description
        DEFAULT_FORMAT: format
        MESSAGE_ONLY: format
        LEVEL_FILTERS: Array[level_filter]
        U64_MAX: Integer

        @_targets: Array[Target]
        @_format: format?
        @_level: level_filter
        @_filters: Array[filter]
        @_rotation_strategy: rotation
        @_timezone_strategy: timezone
        @_max_file_size: Integer
        @_path_resolver: Tokra::Path::Resolver?
        @_app_handle: Tokra::AppHandle?
        @_app_name: String?

        def initialize: () -> void
        def rotation_strategy: (rotation rotation_strategy) -> self
        def timezone_strategy: (timezone timezone_strategy) -> self
        def max_file_size: (Integer max_file_size) -> self
        def clear_format: () -> self
        def format: (?format? formatter) ?{ (String message, Record record) -> String? } -> self
        def level: (Symbol | String level_filter) -> self
        def level_for: (String module_name, Symbol level) -> bot
        def filter: (?filter? callable) ?{ (Metadata metadata) -> boolish } -> self
        def clear_targets: () -> self
        def target: (Target target) -> self
        def targets: (Enumerable[Target] targets) -> self
        def skip_logger: () -> bot
        def split: (Tokra::AppHandle app_handle) -> bot
        def with_colors: (Hash[Symbol, Symbol] colors) -> bot
        def path_resolver: (Tokra::Path::Resolver resolver) -> self
        def app_handle: (Tokra::AppHandle handle) -> self
        def app_name: (String name) -> self
        def build: () -> Plugin
        def configured_targets: () -> Array[Target]
        def configured_format: () -> format?
        def configured_level: () -> level_filter
        def configured_filters: () -> Array[filter]
        def configured_rotation_strategy: () -> rotation
        def configured_timezone_strategy: () -> timezone
        def configured_max_file_size: () -> Integer
        def configured_path_resolver: () -> Tokra::Path::Resolver?
        def configured_app_handle: () -> Tokra::AppHandle?
        def configured_app_name: () -> String?
      end

      class Target
        KINDS: Array[Class]

        @kind: kind
        @filters: Array[filter]
        @formatter: format?

        attr_reader kind: kind
        attr_reader filters: Array[filter]
        attr_reader formatter: format?

        def initialize: (kind kind) -> void
        def filter: (?filter? callback) ?{ (Metadata metadata) -> boolish } -> self
        def format: (?format? callback) ?{ (String message, Record record) -> String? } -> self

        private

        def shareable!: (Proc? callable, String name) -> void
      end

      class Metadata < Data
        attr_reader level: level
        attr_reader target: String
        def self.new: (level level, String target) -> Metadata
                    | (level: level, target: String) -> Metadata
      end

      class Record < Data
        attr_reader args: String
        attr_reader level: level
        attr_reader target: String
        attr_reader file: String?
        attr_reader line: Integer?
        attr_reader key_values: Hash[String, String]
        def self.new: (args: String, level: level, target: String, ?file: String?, ?line: Integer?,
                       ?key_values: Hash[String, String]) -> Record
        def metadata: () -> Metadata
      end

      module LogLevel
        TRACE: Integer
        DEBUG: Integer
        INFO: Integer
        WARN: Integer
        ERROR: Integer
        LEVELS: Hash[Integer, level]

        def self.from: (level level) -> Integer
        def self.to_level: (Integer log_level) -> level
      end

      class RotatingFile
        @dir: Pathname
        @file_name: String
        @path: Pathname
        @max_size: Integer
        @current_size: Integer
        @rotation_strategy: rotation
        @timezone_strategy: timezone
        @inner: File?
        @buffer: String

        def initialize: (String | Pathname dir, String file_name, Integer max_size, rotation rotation_strategy,
                         timezone timezone_strategy) -> void
        def write: (String string) -> String
        def flush: () -> void

        private

        def open_file: () -> File
        def rotate: () -> File
        def remove_old_files: (Integer keep_count) -> void
        def rename_file_to_dated: () -> Integer
      end

      module Output
        module Fallback
          def self.on_error: (Record record) { () -> void } -> void
        end

        class Stream
          @stream: :stdout | :stderr
          @lock: Thread::Mutex

          def initialize: (:stdout | :stderr stream) -> void
          def log: (Record record) -> void
        end

        class Writer
          @file: RotatingFile
          @lock: Thread::Mutex

          def initialize: (RotatingFile file) -> void
          def log: (Record record) -> void
        end

        class Webview
          @app_handle: Tokra::AppHandle

          def initialize: (Tokra::AppHandle app_handle) -> void
          def log: (Record record) -> void
        end

        class Dispatch
          SEVERITIES: Hash[level, Integer]

          @logger: _Logger

          def initialize: (_Logger logger) -> void
          def log: (Record record) -> void
        end
      end

      module RotationStrategy
        class KeepAll < Data
          def self.new: () -> KeepAll
        end

        class KeepOne < Data
          def self.new: () -> KeepOne
        end

        class KeepSome < Data
          attr_reader count: Integer
          def self.new: (Integer count) -> KeepSome
                      | (count: Integer) -> KeepSome
        end
      end

      module TimezoneStrategy
        class UseUtc < Data
          def self.new: () -> UseUtc
          def get_now: () -> Ferro::Time::OffsetDateTime
        end

        class UseLocal < Data
          def self.new: () -> UseLocal
          def get_now: () -> Ferro::Time::OffsetDateTime
        end
      end

      module TargetKind
        class Stdout < Data
          def self.new: () -> Stdout
        end

        class Stderr < Data
          def self.new: () -> Stderr
        end

        class Folder < Data
          attr_reader path: String | Pathname
          attr_reader file_name: String?
          def self.new: (path: String | Pathname, ?file_name: String?) -> Folder
        end

        class LogDir < Data
          attr_reader file_name: String?
          def self.new: (?file_name: String?) -> LogDir
        end

        class Webview < Data
          def self.new: () -> Webview
        end

        class Dispatch < Data
          attr_reader logger: _Logger
          def self.new: (_Logger logger) -> Dispatch
                      | (logger: _Logger) -> Dispatch
        end
      end
    end
  end
end
