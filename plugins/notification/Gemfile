source "https://rubygems.org"

gemspec

gem "tokra", path: "../.."

# ferro-notify-rust is not on RubyGems.org yet, so Bundler takes it from
# Ferro's repository (ADR 011), at its release tag (Plan 024).
gem "ferro-notify-rust", git: "https://github.com/setdef/Ferro", tag: "ferro-notify-rust/v0.1.0.pre.1",
  glob: "gems/notify-rust/*.gemspec"

group :development, :test do
  # The macOS tests read and sweep the notification center through AppKit.
  gem "fiddle"
  gem "minitest"
  gem "minitest-mock"
  gem "rake"
end
