source "https://rubygems.org"

gemspec

gem "tokra", path: "../.."
# tokra reads its config's URLs with ferro-url, which is not on
# RubyGems.org yet, so Bundler takes it from its release tag (ADR 011).
gem "ferro-url", git: "https://github.com/setdef/Ferro", tag: "ferro-url/v0.1.0.pre.1", glob: "gems/url/*.gemspec"

# ferro-arboard is not on RubyGems.org yet, so Bundler takes it from its
# release tag (ADR 011).
gem "ferro-arboard", git: "https://github.com/setdef/Ferro", tag: "ferro-arboard/v0.1.0.pre.2", glob: "gems/*/*.gemspec"

group :development, :test do
  gem "minitest"
  gem "minitest-mock"
  gem "rake"
end
