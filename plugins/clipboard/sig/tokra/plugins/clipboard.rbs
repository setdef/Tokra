module Tokra
  module Plugins
    module Clipboard
      class Error < Tokra::Error
        class Clipboard < Error
        end
      end

      module ClipboardManagerExt
        def clipboard: () -> Clipboard
      end

      class Clipboard
        @clipboard: Ferro::Arboard::Clipboard?
        @error: String?
        @live: Ractor::Port[nil]

        def initialize: () -> void
        def write_text: (String text) -> void
        def write_image: (Tokra::Image image) -> void
        def read_text: () -> String
        def write_html: (String html, ?String? alt_text) -> void
        def clear: () -> void
        def read_image: () -> Tokra::Image
        def cleanup: () -> nil

        private

        def with_clipboard: [T] () { (Ferro::Arboard::Clipboard) -> T } -> T
      end

      class Plugin < Tokra::Plugin
        def name: () -> String
        def read_text: () -> String
        def write_text: (String) -> void
        def read_image: () -> Tokra::Image
        def write_image: (Tokra::Image) -> void
        def write_html: (String html, ?String? alt_text) -> void
        def clear: () -> void
        def extend_api: (Tokra::Ipc::Invoke) -> bool
        def on_event: (Tokra::AppHandle app, Tokra::run_event event) -> void

        private

        def handle_read_text: (Tokra::Ipc::Invoke) -> bool
        def handle_write_text: (Tokra::Ipc::Invoke) -> bool
        def handle_read_image: (Tokra::Ipc::Invoke) -> bool
        def handle_write_image: (Tokra::Ipc::Invoke) -> bool
        def handle_write_html: (Tokra::Ipc::Invoke) -> bool
        def handle_clear: (Tokra::Ipc::Invoke) -> bool
        def clipboard: () -> Clipboard
        def argument: (Tokra::Ipc::Invoke invoke, String key) -> Tokra::Ipc::CommandItem
        def string_arg: (Tokra::Ipc::Invoke invoke, String key) -> String
        def optional_string_arg: (Tokra::Ipc::Invoke invoke, String key, ?expected: String) -> String?
        def string_value: (Tokra::json_value value, String expected) -> String
      end
    end
  end
end
