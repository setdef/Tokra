module Tokra
  module Plugins
    module Clipboard
      class Error < Tokra::Error
        class Clipboard < Error
        end
      end

      module ClipboardManagerExt
        def clipboard: () -> Clipboard
      end

      class Clipboard
        @clipboard: Ferro::Arboard::Clipboard?
        @error: String?
        @live: Ractor::Port[nil]

        def initialize: () -> void
        def write_text: (String text) -> void
        def write_image: (Tokra::Image image) -> void
        def read_text: () -> String
        def write_html: (String html, ?String? alt_text) -> void
        def clear: () -> void
        def read_image: () -> Tokra::Image
        def cleanup: () -> nil

        private

        def with_clipboard: [T] () { (Ferro::Arboard::Clipboard) -> T } -> T
      end

      COMMANDS: Array[String]

      def self.init: () -> Tokra::Plugin::TauriPlugin[nil]
      private def self.handle_invoke: (Tokra::Ipc::Invoke invoke) -> bool

      module Commands
        def self.write_text: (Tokra::Ipc::Invoke invoke, Clipboard clipboard) -> void
        def self.read_text: (Tokra::Ipc::Invoke invoke, Clipboard clipboard) -> void
        def self.write_image: (Tokra::Ipc::Invoke invoke, Clipboard clipboard) -> void
        def self.read_image: (Tokra::Ipc::Invoke invoke, Clipboard clipboard) -> void
        def self.write_html: (Tokra::Ipc::Invoke invoke, Clipboard clipboard) -> void
        def self.clear: (Tokra::Ipc::Invoke invoke, Clipboard clipboard) -> void
        private def self.argument: (Tokra::Ipc::Invoke invoke, String key) -> Tokra::Ipc::CommandItem
        private def self.string_arg: (Tokra::Ipc::Invoke invoke, String key) -> String
        private def self.optional_string_arg: (Tokra::Ipc::Invoke invoke, String key, ?expected: String) -> String?
        private def self.string_value: (Tokra::json_value value, String expected) -> String
      end
    end
  end
end
