require "bundler/gem_tasks"
require "rake/testtask"
require "rb_sys/extensiontask"

GEMSPEC = Gem::Specification.load("tokra-clipboard.gemspec")

RbSys::ExtensionTask.new("tokra_clipboard", GEMSPEC) do |ext|
  ext.lib_dir = "lib/tokra_clipboard"
  ext.ext_dir = "ext/tokra_clipboard"
end

Rake::TestTask.new do |t|
  t.libs << "lib"
  t.pattern = "test/**/test_*.rb"
  t.warning = true
end

task build: :compile
task default: [:compile, :test]
