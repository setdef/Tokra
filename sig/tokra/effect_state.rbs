module Tokra
  class EffectState < Data
    extend ClosedEnum
    include ClosedEnum::With

    attr_reader name: String

    private def self.new: (name: String) -> EffectState
    def self.deserialize: (json_value value) -> EffectState

    VARIANTS: Array[EffectState]

    FollowsWindowActiveState: EffectState
    Active: EffectState
    Inactive: EffectState
  end
end
