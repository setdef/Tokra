module Tokra
  module Native
    class EventLoop
      def self.new: () -> EventLoop
      def self.gvl_handoff_counts: () -> Hash[String, Integer]
      def create_proxy: () -> Proxy
      def run: (^(native_event) -> void) -> bot
      def cursor_position: () -> [[Float, Float]?]?
      def primary_monitor: () -> [Window::monitor?]?
      def monitor_from_point: (Float, Float) -> [Window::monitor?]?
      def available_monitors: () -> Array[Window::monitor]?
      def set_theme: (String?) -> nil
    end

    class Icon
      def self.from_rgba: (String rgba, Integer width, Integer height) -> Icon
    end

    class Window
      def self.new: (EventLoop, String label) -> Window
      def self.empty: (Proxy) -> Window
      def open: (EventLoop?, String label, Hash[Symbol, attribute] attributes) -> nil
      def id: () -> String?
      def title: () -> String?
      def close: () -> nil
      def discard: () -> nil
      def set_title: (String) -> void
      def set_size: (Float, Float) -> void
      def set_always_on_top: (bool) -> void
      def set_ignore_cursor_events: (bool) -> void
      def raw_window_handle: () -> RawWindowHandle::native_window_handle
      def raw_display_handle: () -> RawWindowHandle::native_display_handle

      type dimensions = [bool, Float, Float]
      type point = [Integer, Integer]
      type extent = [Integer, Integer]
      type monitor = [String?, point, extent, [point, extent], Float]
      type unit = [bool, Float]
      type rgba = [Integer, Integer, Integer, Integer]
      type attribute = String | bool | [Float, Float] | dimensions | Array[unit?] | rgba | Icon | Window | nil

      def scale_factor: () -> Float?
      def inner_position: () -> [point?]?
      def outer_position: () -> [point?]?
      def inner_size: (WebView?) -> extent?
      def outer_size: () -> extent?
      def is_fullscreen: () -> bool?
      def is_minimized: () -> bool?
      def is_maximized: () -> bool?
      def is_focused: () -> bool?
      def is_decorated: () -> bool?
      def is_resizable: () -> bool?
      def is_maximizable: () -> bool?
      def is_minimizable: () -> bool?
      def is_closable: () -> bool?
      def is_visible: () -> bool?
      def is_always_on_top: () -> bool?
      def theme: () -> String?
      def current_monitor: () -> [monitor?]?
      def primary_monitor: () -> [monitor?]?
      def monitor_from_point: (Float, Float) -> [monitor?]?
      def available_monitors: () -> Array[monitor]?
      def center: () -> nil
      def request_user_attention: (String?) -> nil
      def set_resizable: (bool) -> nil
      def set_maximizable: (bool) -> nil
      def set_minimizable: (bool) -> nil
      def set_closable: (bool) -> nil
      def set_maximized: (bool) -> nil
      def set_minimized: (bool) -> nil
      def set_visible: (bool) -> nil
      def set_decorations: (bool) -> nil
      def set_always_on_bottom: (bool) -> nil
      def set_visible_on_all_workspaces: (bool) -> nil
      def set_content_protection: (bool) -> nil
      def set_focusable: (bool) -> nil
      def set_cursor_visible: (bool) -> nil
      def set_inner_size: (dimensions) -> nil
      def set_min_inner_size: (dimensions?) -> nil
      def set_max_inner_size: (dimensions?) -> nil
      def set_outer_position: (dimensions) -> nil
      def set_fullscreen: (bool) -> nil
      def set_simple_fullscreen: (bool) -> nil
      def set_focus: () -> nil
      def set_skip_taskbar: (bool) -> nil
      def set_cursor_grab: (bool) -> nil
      def set_cursor_icon: (String) -> nil
      def set_cursor_position: (dimensions) -> nil
      def drag_window: () -> nil
      def drag_resize_window: (String) -> nil
      def set_theme: (String?) -> nil
      def is_enabled: () -> bool?
      def set_enabled: (bool) -> nil
      def set_inner_size_constraints: (Array[unit?]) -> nil
      def set_window_icon: (Icon) -> nil
      def set_background_color: (rgba?) -> nil
      def set_shadow: (bool) -> nil

      type effects = [Array[String], String?, Float?, rgba?]

      def set_effects: (effects?) -> nil
      def set_progress_bar: (String?, Integer?, String?) -> nil
      def set_badge_count: (Integer?, String?) -> nil
      def set_title_bar_style: (String) -> nil
    end

    class WebView
      def self.new_with_protocol: (Window, Proxy, String label, Array[String]) -> WebView
      def self.empty: (Proxy) -> WebView
      type script = [String, bool]
      type proxy = [String, String, String]
      type attribute = String | bool | Array[script] | proxy | Array[Integer] | Window::rgba | Window::dimensions | nil

      def open: (Window, Proxy, String label, Hash[Symbol, attribute] attributes) -> nil
      def eval: (String) -> void
      def close: () -> nil
      def set_background_color: (Window::rgba?) -> nil
    end

    class Proxy
      def wake_up: (String payload) -> void
      def send_task: () -> nil
      def request_exit: (Integer code) -> nil
      def request_close: (String label) -> nil
      def respond: (Integer request_id, Integer status, Array[[String, String]] headers, String body) -> void
      def drop_response: (Integer request_id) -> void
    end

    class HttpRequestEvent < Data
      def label: () -> String
      def request_id: () -> Integer
      def method: () -> String
      def uri: () -> String
      def headers: () -> Array[[String, String]]
      def body: () -> String
      def self.new: (String label, Integer request_id, String method, String uri, Array[[String, String]] headers, String body) -> HttpRequestEvent
                  | (label: String, request_id: Integer, method: String, uri: String, headers: Array[[String, String]], body: String) -> HttpRequestEvent
    end

    class IpcEvent < Data
      def label: () -> String
      def message: () -> String
      def url: () -> String
      def self.new: (String label, String message, String url) -> IpcEvent
                  | (label: String, message: String, url: String) -> IpcEvent
    end

    class WakeUpEvent < Data
      def payload: () -> String
      def self.new: (String payload) -> WakeUpEvent
    end

    class WindowCloseEvent < Data
      attr_reader label: String
      def self.new: (String label) -> WindowCloseEvent
    end

    class WindowDestroyedEvent < Data
      attr_reader label: String
      def self.new: (String label) -> WindowDestroyedEvent
    end

    class WindowResizedEvent < Data
      attr_reader label: String
      def self.new: (String label) -> WindowResizedEvent
    end

    class WindowMovedEvent < Data
      attr_reader label: String
      attr_reader x: Integer
      attr_reader y: Integer
      def self.new: (String label, Integer x, Integer y) -> WindowMovedEvent
    end

    class WindowFocusedEvent < Data
      attr_reader label: String
      attr_reader focused: bool
      def self.new: (String label, bool focused) -> WindowFocusedEvent
    end

    class WebviewFocusedEvent < Data
      attr_reader label: String
      attr_reader focused: bool
      def self.new: (String label, bool focused) -> WebviewFocusedEvent
    end

    class WindowScaleFactorChangedEvent < Data
      attr_reader label: String
      attr_reader scale_factor: Float
      attr_reader width: Integer
      attr_reader height: Integer
      def self.new: (String label, Float scale_factor, Integer width, Integer height) -> WindowScaleFactorChangedEvent
    end

    class WindowThemeChangedEvent < Data
      attr_reader label: String
      attr_reader theme: String
      def self.new: (String label, String theme) -> WindowThemeChangedEvent
    end

    class ExitRequestedEvent < Data
      attr_reader code: Integer
      def self.new: (Integer code) -> ExitRequestedEvent
    end

    class LoopDestroyedEvent < Data
      def self.new: () -> LoopDestroyedEvent
    end

    class TaskEvent < Data
      def self.new: () -> TaskEvent
    end

    class PageLoadEvent < Data
      def self.new: (String label, String event, String url) -> PageLoadEvent
      def label: () -> String
      def event: () -> String
      def url: () -> String
      def started?: () -> bool
      def finished?: () -> bool
    end

    def self.load_js_template: (String name) -> String

    class DragDropEvent < Data
      def label: () -> String
      def event: () -> String
      def paths: () -> Array[String]
      def x: () -> Integer
      def y: () -> Integer
      def self.new: (String label, String, Array[String], Integer, Integer) -> DragDropEvent
    end

    def self.home_dir: () -> String
    def self.data_local_dir: () -> String

    def self.image_from_bytes: (String bytes) -> [String, Integer, Integer]

    def self.fs_read: (String path) -> String
  end
end
