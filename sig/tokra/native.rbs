module Tokra
  module Native
    class EventLoop
      def self.new: () -> EventLoop
      def create_proxy: () -> Proxy
      def run: (^(native_event) -> void) -> bot
    end

    class Window
      def self.new: (EventLoop) -> Window
      def id: () -> String
      def title: () -> String
      def set_title: (String) -> void
      def set_size: (Float, Float) -> void
      def set_always_on_top: (bool) -> void
      def set_ignore_cursor_events: (bool) -> void
      def raw_window_handle: () -> RawWindowHandle::native_window_handle
      def raw_display_handle: () -> RawWindowHandle::native_display_handle
    end

    class WebView
      def self.new_with_protocol: (Window, Proxy, Array[String]) -> WebView
      def self.new: (Window, String, ^(String) -> void, Proxy) -> WebView
      def eval: (String) -> void
    end

    class Proxy
      def wake_up: (String payload) -> void
      def send_task: () -> nil
      def respond: (Integer request_id, Integer status, Array[[String, String]] headers, String body) -> void
      def drop_response: (Integer request_id) -> void
    end

    class HttpRequestEvent < Data
      def request_id: () -> Integer
      def method: () -> String
      def uri: () -> String
      def headers: () -> Array[[String, String]]
      def body: () -> String
      def self.new: (Integer request_id, String method, String uri, Array[[String, String]] headers, String body) -> HttpRequestEvent
    end

    class IpcEvent < Data
      def message: () -> String
      def url: () -> String
      def self.new: (String message, String url) -> IpcEvent
                  | (message: String, url: String) -> IpcEvent
    end

    class WakeUpEvent < Data
      def payload: () -> String
      def self.new: (String payload) -> WakeUpEvent
    end

    class WindowCloseEvent < Data
      def self.new: () -> WindowCloseEvent
    end

    class LoopDestroyedEvent < Data
      def self.new: () -> LoopDestroyedEvent
    end

    class TaskEvent < Data
      def self.new: () -> TaskEvent
    end

    class PageLoadEvent < Data
      def self.new: (String event, String url) -> PageLoadEvent
      def event: () -> String
      def url: () -> String
      def started?: () -> bool
      def finished?: () -> bool
    end

    def self.emit_js_script: (String event, String payload) -> String

    def self.load_js_template: (String name) -> String

    class DragDropEvent < Data
      def event: () -> String
      def paths: () -> Array[String]
      def x: () -> Integer
      def y: () -> Integer
      def self.new: (String, Array[String], Integer, Integer) -> DragDropEvent
    end

    def self.home_dir: () -> String
    def self.data_local_dir: () -> String

    def self.image_from_bytes: (String bytes) -> [String, Integer, Integer]
  end
end
