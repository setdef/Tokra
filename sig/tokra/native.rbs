module Tokra
  module Native
    class EventLoop
      def initialize: () -> void
      def create_proxy: () -> Proxy
      def run: (^(native_event) -> void) -> void
    end

    class Window
      def initialize: (EventLoop) -> void
      def set_title: (String) -> void
      def set_size: (Float, Float) -> void
    end

    class WebView
      def self.new_with_protocol: (Window, Proxy, Array[String]) -> WebView
      def initialize: (Window, String, ^(String) -> void, Proxy) -> void
      def eval: (String) -> void
    end

    class Proxy
      def wake_up: (String payload) -> void
      def respond: (Integer request_id, Integer status, Array[[String, String]] headers, String body) -> void
      def drop_response: (Integer request_id) -> void
    end

    class HttpRequestEvent
      def request_id: () -> Integer
      def method: () -> String
      def uri: () -> String
      def headers: () -> Array[[String, String]]
      def body: () -> String
    end

    class IpcEvent < Data
      def message: () -> String
      def url: () -> String
      def self.new: (String message, String url) -> IpcEvent
                  | (message: String, url: String) -> IpcEvent
    end

    class WakeUpEvent
    end

    class WindowCloseEvent
    end

    class LoopDestroyedEvent < Data
      def self.new: () -> LoopDestroyedEvent
    end

    class PageLoadEvent
      def event: () -> String
      def url: () -> String
      def started?: () -> bool
      def finished?: () -> bool
    end

    def self.emit_js_script: (String event, String payload) -> String

    def self.load_js_template: (String name) -> String

    class DragDropEvent < Data
      def event: () -> String
      def paths: () -> Array[String]
      def x: () -> Integer
      def y: () -> Integer
      def self.new: (String, Array[String], Integer, Integer) -> DragDropEvent
    end

    def self.home_dir: () -> String
    def self.data_local_dir: () -> String

    def self.image_from_bytes: (String bytes) -> [String, Integer, Integer]
  end
end
