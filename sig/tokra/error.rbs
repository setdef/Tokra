module Tokra
  # Base error class for all Tokra errors.
  class Error < StandardError
    # Raised when image bytes cannot be decoded.
    class Image < Error
    end

    class Io < Error
    end

    # Raised when a call cannot reach the main thread, or its answer never comes back.
    class Runtime < Error
      FAILED_TO_SEND_MESSAGE: String
      FAILED_TO_RECEIVE_MESSAGE: String
      FAILED_TO_GET_CURSOR_POSITION: String

      def initialize: (String message) -> void
    end

    class FailedToReceiveMessage < Error
      def initialize: (?String message) -> void
    end

    class Menu < Error
      def initialize: (String message) -> void
    end

    class BadMenuIcon < Error
    end

    class PluginInitialization < Error
      attr_reader plugin: String

      def initialize: (String plugin, String message) -> void
    end

    class InvalidArgs < Error
      attr_reader command: String
      attr_reader key: String

      def initialize: (String command, String key, String reason) -> void
    end

    # Raised when a resource ID is not found in a ResourceTable.
    class BadResourceId < Error
      attr_reader rid: Integer

      def initialize: (Integer rid) -> void
    end
  end
end
