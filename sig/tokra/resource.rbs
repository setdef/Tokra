module Tokra
  # Interface for objects stored in ResourceTable.
  interface _Resource
    def name: () -> String
    def close: () -> void
  end

  # Mixin for objects stored in ResourceTable.
  module Resource : _Resource
    def name: () -> String
    def close: () -> nil
  end
end
