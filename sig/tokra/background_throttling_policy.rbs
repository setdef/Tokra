module Tokra
  class BackgroundThrottlingPolicy < Data
    extend ClosedEnum
    include ClosedEnum::With

    attr_reader name: String

    private def self.new: (name: String) -> BackgroundThrottlingPolicy
    def self.deserialize: (json_value value) -> BackgroundThrottlingPolicy

    Disabled: BackgroundThrottlingPolicy
    Suspend: BackgroundThrottlingPolicy
    Throttle: BackgroundThrottlingPolicy
  end
end
