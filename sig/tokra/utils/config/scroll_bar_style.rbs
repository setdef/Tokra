module Tokra
  module Utils
    module Config
      class ScrollBarStyle < Data
        extend ClosedEnum
        include ClosedEnum::With

        attr_reader name: String

        private def self.new: (name: String) -> ScrollBarStyle
        def self.deserialize: (json_value value) -> ScrollBarStyle

        Default: ScrollBarStyle
        FluentOverlay: ScrollBarStyle
      end
    end
  end
end
