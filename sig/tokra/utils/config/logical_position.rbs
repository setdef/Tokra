module Tokra
  module Utils
    module Config
      class LogicalPosition < Data
        FIELDS: Array[Field]

        attr_reader x: Float
        attr_reader y: Float

        def self.new: (Float x, Float y) -> LogicalPosition
                    | (x: Float, y: Float) -> LogicalPosition
        def self.deserialize: (json_value value) -> LogicalPosition
      end
    end
  end
end
