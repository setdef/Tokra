module Tokra
  module Utils
    module Config
      class BundleConfig < Data
        STRING: reader
        STRINGS: reader
        FIELDS: Array[Field]
        DEFAULTS: Hash[Symbol, top]

        attr_reader active: bool
        attr_reader targets: bundle_target
        attr_reader create_updater_artifacts: updater
        attr_reader publisher: String?
        attr_reader homepage: String?
        attr_reader icon: Array[String]
        attr_reader resources: bundle_resources?
        attr_reader copyright: String?
        attr_reader license: String?
        attr_reader license_file: Pathname?
        attr_reader category: String?
        attr_reader file_associations: Array[FileAssociation]?
        attr_reader short_description: String?
        attr_reader long_description: String?
        attr_reader use_local_tools_dir: bool
        attr_reader external_bin: Array[String]?
        attr_reader windows: WindowsConfig
        attr_reader linux: LinuxConfig
        attr_reader macos: MacConfig
        attr_reader ios: IosConfig
        attr_reader android: AndroidConfig

        def self.new: (?active: bool, ?targets: bundle_target, ?create_updater_artifacts: updater, ?publisher: String?,
                       ?homepage: String?, ?icon: Array[String], ?resources: bundle_resources?, ?copyright: String?,
                       ?license: String?, ?license_file: Pathname?, ?category: String?, ?file_associations: Array[FileAssociation]?,
                       ?short_description: String?, ?long_description: String?, ?use_local_tools_dir: bool,
                       ?external_bin: Array[String]?, ?windows: WindowsConfig, ?linux: LinuxConfig, ?macos: MacConfig,
                       ?ios: IosConfig, ?android: AndroidConfig) -> BundleConfig
        def self.deserialize: (json_value value) -> BundleConfig
      end
    end
  end
end
