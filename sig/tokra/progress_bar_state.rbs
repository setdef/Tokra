module Tokra
  class ProgressBarState < Data
    attr_reader status: ProgressBarStatus?
    attr_reader progress: Integer?

    def self.new: (?ProgressBarStatus? status, ?Integer? progress) -> ProgressBarState
                | (?status: ProgressBarStatus?, ?progress: Integer?) -> ProgressBarState
  end
end
