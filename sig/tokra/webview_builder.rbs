module Tokra
  class WebviewBuilder
    @label: String
    @url: webview_url
    @initialization_scripts: Array[Native::WebView::script]
    @attributes: Hash[Symbol, Native::WebView::attribute]

    attr_reader label: String
    attr_reader url: webview_url

    def initialize: (String label, webview_url url) -> void
    def self.from_config: (Utils::Config::WindowConfig config) -> WebviewBuilder
    def self.scroll_bar_style_of: (Utils::Config::ScrollBarStyle style) -> ScrollBarStyle
    def native_attributes: () -> Hash[Symbol, Native::WebView::attribute]
    def initialization_scripts: () -> Array[Native::WebView::script]
    def accept_first_mouse: (bool accept) -> self
    def initialization_script: (String script) -> self
    def initialization_script_for_all_frames: (String script) -> self
    def user_agent: (String user_agent) -> self
    def additional_browser_args: (String additional_args) -> self
    def disable_drag_drop_handler: () -> self
    def enable_clipboard_access: () -> self
    def incognito: (bool incognito) -> self
    def proxy_url: (Ferro::Url::Url url) -> self
    def self.proxy_endpoint: (Ferro::Url::Url url) -> Native::WebView::proxy
    def focused: (bool focus) -> self
    def browser_extensions_enabled: (bool enabled) -> self
    def extensions_path: (String | _ToPath path) -> self
    def data_store_identifier: (Array[Integer] data_store_identifier) -> self
    def background_color: (Color color) -> self
    def background_throttling: (BackgroundThrottlingPolicy policy) -> self
    def disable_javascript: () -> self
    def scroll_bar_style: (ScrollBarStyle style) -> self
    def set_traffic_light_position: (Native::Window::dimensions dimensions) -> self

    private

    def with_config: (Utils::Config::WindowConfig config) -> nil
    def script: (String script, bool for_main_frame_only) -> self
    def set: (Symbol key, Native::WebView::attribute value) -> self
    def flag: (Symbol key, boolish value) -> self
    def expect: (Object? value, Module type) -> nil
  end
end
