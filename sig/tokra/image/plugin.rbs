module Tokra
  class Image
    class Plugin < Tokra::Plugin
      def name: () -> String
      def extend_api: (Ipc::Invoke invoke) -> bool

      private

      def handle_new: (Ipc::Invoke invoke) -> bool
      def handle_rgba: (Ipc::Invoke invoke) -> bool
      def handle_size: (Ipc::Invoke invoke) -> bool
      def handle_from_bytes: (Ipc::Invoke invoke) -> bool
      def handle_from_path: (Ipc::Invoke invoke) -> bool
      def image_arg: (Ipc::Invoke invoke) -> Image
      def integer_arg: (Ipc::Invoke invoke, String key) -> Integer
      def array_arg: (Ipc::Invoke invoke, String key) -> Array[json_value]
      def string_arg: (Ipc::Invoke invoke, String key) -> String
    end
  end
end
