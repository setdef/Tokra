module Tokra
  module Path
    interface _Configured
      def config: () -> Config
    end

    interface _Env
      def []: (String name) -> String?
      def key?: (String name) -> bool
    end

    class PathResolver
      @app: _Configured
      @dirs: Object
      @target: Utils::Platform::Target
      @env: _Env

      attr_reader target: Utils::Platform::Target

      def initialize: (_Configured app, ?dirs: Object, ?target: Utils::Platform::Target, ?env: _Env) -> void
      def file_name: (String | _ToPath path) -> String?
      def audio_dir: () -> Pathname
      def cache_dir: () -> Pathname
      def config_dir: () -> Pathname
      def data_dir: () -> Pathname
      def local_data_dir: () -> Pathname
      def desktop_dir: () -> Pathname
      def document_dir: () -> Pathname
      def download_dir: () -> Pathname
      def executable_dir: () -> Pathname
      def font_dir: () -> Pathname
      def home_dir: () -> Pathname
      def picture_dir: () -> Pathname
      def public_dir: () -> Pathname
      def runtime_dir: () -> Pathname
      def template_dir: () -> Pathname
      def video_dir: () -> Pathname
      def resource_dir: () -> Pathname
      def app_config_dir: () -> Pathname
      def app_data_dir: () -> Pathname
      def app_local_data_dir: () -> Pathname
      def app_cache_dir: () -> Pathname
      def app_log_dir: () -> Pathname
      def temp_dir: () -> Pathname
      def resolve: (String | _ToPath path, BaseDirectory base_directory) -> Pathname
      def parse: (String | _ToPath path) -> Pathname
      def resolve_path: (BaseDirectory directory, ?String? path) -> Pathname

      private

      def directory_for: (BaseDirectory directory) -> Pathname
      def resource_path: (String path) -> String
      def dir: (Symbol function) -> Pathname
      def join: (Pathname base, String name) -> Pathname
      def identifier: () -> String
      def std: () -> Std
      def unix_temp_dir: () -> String
      def windows_temp_dir: () -> String
    end

    class Resolver = PathResolver
  end
end
