module Tokra
  class TitleBarStyle < Data
    extend ClosedEnum
    include ClosedEnum::With

    attr_reader name: String

    private def self.new: (name: String) -> TitleBarStyle
    def self.deserialize: (json_value value) -> TitleBarStyle

    Visible: TitleBarStyle
    Transparent: TitleBarStyle
    Overlay: TitleBarStyle
  end
end
