module Tokra
  class PhysicalRect < Data
    attr_reader position: PhysicalPosition
    attr_reader size: PhysicalSize

    def self.new: (PhysicalPosition position, PhysicalSize size) -> PhysicalRect
                | (position: PhysicalPosition, size: PhysicalSize) -> PhysicalRect
  end
end
