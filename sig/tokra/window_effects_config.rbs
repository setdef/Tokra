module Tokra
  class WindowEffectsConfig < Data
    attr_reader effects: Array[Effect]
    attr_reader state: EffectState?
    attr_reader radius: Float?
    attr_reader color: Color?

    def self.new: (?Array[Effect] effects, ?EffectState? state, ?Numeric? radius, ?Color? color) -> WindowEffectsConfig
                | (?effects: Array[Effect], ?state: EffectState?, ?radius: Numeric?, ?color: Color?) -> WindowEffectsConfig
  end
end
