module Tokra
  class LogicalSize < Data
    attr_reader width: pixel
    attr_reader height: pixel

    def self.new: (pixel width, pixel height) -> LogicalSize
                | (width: pixel, height: pixel) -> LogicalSize
    def self.from_physical: (PhysicalSize size, Float | Integer scale_factor) -> LogicalSize
    def to_physical: (Float | Integer scale_factor) -> PhysicalSize
  end
end
