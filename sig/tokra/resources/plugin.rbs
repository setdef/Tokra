module Tokra
  module Resources
    interface _ResourcesTableHolder
      def resources_table: () -> ResourceTable
    end

    class Plugin < Tokra::Plugin
      def name: () -> String
      def extend_api: (Ipc::Invoke invoke) -> bool

      private

      def try_close: (_ResourcesTableHolder manager, Integer rid) -> Error::BadResourceId?
    end
  end
end
