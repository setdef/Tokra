module Tokra
  class PermissionState < Data
    Granted: PermissionState
    Denied: PermissionState
    Prompt: PermissionState
    PromptWithRationale: PermissionState

    attr_reader name: String

    def self.new: (name: String) -> PermissionState
    def self.default: () -> PermissionState
    def to_s: () -> String
    def to_json: (?JSON::State? state) -> String
  end
end
