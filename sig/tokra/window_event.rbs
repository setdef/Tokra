module Tokra
  module WindowEvent
    class CloseRequested < Data
      attr_reader api: CloseRequestApi
      def self.new: (api: CloseRequestApi) -> CloseRequested
    end
    class Destroyed < Data
      def self.new: () -> Destroyed
    end
    class Focused < Data
      attr_reader focused: bool
      def self.new: (bool focused) -> Focused
                  | (focused: bool) -> Focused
    end
    class Moved < Data
      attr_reader position: PhysicalPosition
      def self.new: (PhysicalPosition position) -> Moved
                  | (position: PhysicalPosition) -> Moved
    end
    class Resized < Data
      attr_reader size: PhysicalSize
      def self.new: (PhysicalSize size) -> Resized
                  | (size: PhysicalSize) -> Resized
    end
    class ScaleFactorChanged < Data
      attr_reader scale_factor: Float
      attr_reader new_inner_size: PhysicalSize
      def self.new: (Float scale_factor, PhysicalSize new_inner_size) -> ScaleFactorChanged
                  | (scale_factor: Float, new_inner_size: PhysicalSize) -> ScaleFactorChanged
    end
    class DragDrop < Data
      attr_reader event: drag_drop_event
      def self.new: (drag_drop_event event) -> DragDrop
                  | (event: drag_drop_event) -> DragDrop
    end
    class ThemeChanged < Data
      attr_reader theme: Theme
      def self.new: (Theme theme) -> ThemeChanged
                  | (theme: Theme) -> ThemeChanged
    end
  end

  type window_event = WindowEvent::CloseRequested | WindowEvent::Destroyed | WindowEvent::Focused | WindowEvent::Moved
                    | WindowEvent::Resized | WindowEvent::ScaleFactorChanged | WindowEvent::DragDrop | WindowEvent::ThemeChanged
end
