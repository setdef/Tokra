module Tokra
  module WebviewUrl
    class App < Data
      attr_reader path: Pathname
      def self.new: (String | Pathname path) -> App
                  | (path: String | Pathname) -> App
    end

    class External < Data
      attr_reader url: Ferro::Url::Url
      def self.new: (Ferro::Url::Url url) -> External
                  | (url: Ferro::Url::Url) -> External
    end

    class CustomProtocol < Data
      attr_reader url: Ferro::Url::Url
      def self.new: (Ferro::Url::Url url) -> CustomProtocol
                  | (url: Ferro::Url::Url) -> CustomProtocol
    end

    def self.deserialize: (json_value value) -> (App | External | CustomProtocol)
    def self.held: (Ferro::Url::Url url) -> Ferro::Url::Url
  end

  type webview_url = WebviewUrl::App | WebviewUrl::External | WebviewUrl::CustomProtocol
end
