module Tokra
  class PhysicalPosition < Data
    attr_reader x: pixel
    attr_reader y: pixel

    def self.new: (pixel x, pixel y) -> PhysicalPosition
                | (x: pixel, y: pixel) -> PhysicalPosition
    def self.from_logical: (LogicalPosition position, Float | Integer scale_factor) -> PhysicalPosition
    def to_logical: (Float | Integer scale_factor) -> LogicalPosition
  end
end
