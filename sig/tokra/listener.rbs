module Tokra
  module Listener : _Listener
    def listen_any: (String event) { (Event) -> void } -> Integer
    def once_any: (String event) { (Event) -> void } -> Integer
  end

  interface _Listener
    def app_handle: () -> AppHandle
  end
end
