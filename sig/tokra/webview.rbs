module Tokra
  # Webview wrapper holding native webview reference and ResourceTable.
  # Mirrors Tauri's Webview<R> struct.
  class Webview
    include Manager
    include Listener
    include Emitter

    @label: String
    @native: Native::WebView
    @window: Window
    @app_handle: AppHandle
    @resources_table: ResourceTable

    attr_reader label: String
    attr_reader app_handle: AppHandle
    attr_reader native: Native::WebView

    def initialize: (label: String, native: Native::WebView, window: Window, app_handle: AppHandle) -> void
    def window: () -> Window
    def window=: (Window) -> Window
    def resources_table: () -> ResourceTable
    def evaluate: (String script) -> nil
    alias eval evaluate
    def set_background_color: (Color? color) -> nil
    def url: () -> URI::Generic
    def navigate: (URI::Generic url) -> nil
    def reload: () -> nil
    def cookies_for_url: (URI::Generic url) -> Array[Cookie]
    def cookies: () -> Array[Cookie]
    def set_cookie: (Cookie cookie) -> nil
    def delete_cookie: (Cookie cookie) -> nil
    private def query: [T < Object] () { (Native::WebView) -> T? } -> T
    private def absolute: (Object url) -> URI::Generic
    private def command: (String failure) { (Native::WebView) -> void } -> nil
    def cursor_position: () -> PhysicalPosition
    def run_on_main_thread: () { () -> void } -> nil
    def listen_js: (String event, event_target target, Integer handler) -> Integer
    def unlisten_js: (String event, Integer id) -> nil
    def emit_js: (Event::EmitArgs emit_args, Array[Integer] ids) -> nil
    def listen: (String event) { (Event) -> void } -> Integer
    def once: (String event) { (Event) -> void } -> Integer
    def unlisten: (Integer id) -> nil
  end
end
