module Tokra
  class App
    include Manager

    DEFAULT_CONFIG: Hash[Symbol, String | Integer | Float]
    EMIT_FUNCTION_NAME: String
    LISTENERS_OBJECT_NAME: String
    IPC_CORS_HEADERS: Array[[String, String]]
    MAX_CALLBACK_ID: Integer
    MEDIA_TYPE: Regexp
    HEADER_NAME: Regexp
    HEADER_VALUE: Regexp
    VISIBLE_ASCII: Regexp

    class IpcMessageError < Error
    end

    class IpcProtocolError < Error
    end

    @window_config: Hash[Symbol, String | Integer | Float]
    @manager: AppManager
    @handle: AppHandle
    @runtime_context: RuntimeContext
    @builder: Builder
    @with_global_tauri: bool
    @activation_policy: ActivationPolicy?
    @event_loop_class: singleton(Native::EventLoop)
    @window_class: singleton(Native::Window)
    @webview_class: singleton(Native::WebView)
    @window: Window?
    @webview: Webview?
    @rack_handler: ::Rack::Handler::Tokra?

    attr_reader handle: AppHandle

    def invoke_key: () -> String
    def app_handle: () -> AppHandle
    def resources_table: () -> ResourceTable
    def initialize: (Builder builder, ?native: Module) -> void
    def run: () { (AppHandle, run_event) -> void } -> void
         | () -> void
    def on_menu_event: () { (AppHandle, Menu::MenuEvent) -> void } -> nil
    def menu: () -> Menu::Menu?
    def set_menu: (Menu::Menu menu) -> Menu::Menu?
    def remove_menu: () -> Menu::Menu?
    def hide_menu: () -> nil
    def show_menu: () -> nil
    def run_on_main_thread: () { () -> void } -> nil
    def display_handle: () -> RawWindowHandle::display_handle
    def primary_monitor: () -> Monitor?
    def monitor_from_point: (Float | Integer x, Float | Integer y) -> Monitor?
    def available_monitors: () -> Array[Monitor]
    def cursor_position: () -> PhysicalPosition

    private

    def install_app_menu: () -> void
    def prepare_window_menu: (Native::Window native_window) -> Window::WindowMenu?
    def dispatch_menu_event: (Native::MenuEvent native_event, (^(AppHandle, run_event) -> void)? callback) -> void
    def emit_run_event: (run_event event, (^(AppHandle, run_event) -> void)? callback) -> void
    def build_ipc_responder: (json_value callback, json_value error, ?can_use_channel: bool) -> ipc_responder?
    def can_use_channel_for_response?: (String cmd, json_value options) -> bool
    def report_ipc_message_error: (String message) -> void
    def initialization_scripts: () -> Array[String]
    def global_api_script: () -> String
    def bootstrap_script: () -> String
    def invoke_initialization_script: () -> String
    def metadata_script: () -> String
    def init_script: () -> String
    def render_js_template: (String name, Hash[Symbol, String] values) -> String
    def os_name: () -> String
    def dispatch_event: (native_event event, (^(AppHandle, run_event) -> void)? callback, Native::Window window, Native::Proxy proxy) -> (bool | void)
    def dispatch_http_request: (Native::HttpRequestEvent event, Native::Proxy proxy) -> void
    def dispatch_ipc: (Native::IpcEvent event) -> void
    def post_message_headers: (json_value options) -> Hash[String, String]
    def route_invoke: (String cmd, invoke_body body, Hash[String, String] headers, ipc_responder? responder, String origin) -> void
    def plugin_command: (String cmd) -> [String, String]?
    def tokra_protocol_url: () -> URI::Generic
    def local_url?: (String url) -> bool
    def dispatch_ipc_protocol: (Native::HttpRequestEvent event, Native::Proxy proxy) -> void
    def dispatch_ipc_protocol_post: (Native::HttpRequestEvent event, Native::Proxy proxy) -> void
    def parse_ipc_protocol_request: (Native::HttpRequestEvent event) -> [String, String, String, invoke_body]
    def decode_ipc_command: (String uri) -> String
    def ipc_content_type: (Array[[String, String]] headers) -> String
    def ipc_origin: (Array[[String, String]] headers) -> String
    def absolute_url?: (String value) -> bool
    def parse_ipc_payload: (String content_type, String body) -> invoke_body
    def validate_ipc_callback_id: (Array[[String, String]] headers, String header_name, String kind) -> void
    def request_headers: (Array[[String, String]] pairs) -> Hash[String, String]
    def visible_ascii?: (String value) -> bool
    def http_header: (Array[[String, String]] headers, String name) -> String?
    def build_ipc_protocol_responder: (Native::Proxy proxy, Integer request_id) -> ipc_responder
    def respond_ipc_error: (Native::Proxy proxy, Integer request_id, Integer status, String message) -> void
    def ipc_protocol_request?: (String uri) -> bool
    def dispatch_page_load: (Native::PageLoadEvent event) -> void
    def close_requested: (Native::Window window, (^(AppHandle, run_event) -> void)? callback) -> void
    def window_destroyed: (Native::Window window, (^(AppHandle, run_event) -> void)? callback) -> bool
    def exit_requested: (Integer? code, (^(AppHandle, run_event) -> void)? callback) -> bool
    def reporting: () { () -> void } -> void
    def dispatch_window_event: (Native::Window window, window_event event, (^(AppHandle, run_event) -> void)? callback) -> void
    def dispatch_webview_event: (Native::DragDropEvent native_event) -> void
  end
end
