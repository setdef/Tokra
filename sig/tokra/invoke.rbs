module Tokra
  # Invoke object for IPC commands.
  class Invoke
    @command: String
    @payload: Hash[String, json_value]
    @responder: (^(bool, json_value) -> void)?
    @webview: Webview
    @responded: bool

    attr_reader command: String
    attr_reader payload: Hash[String, json_value]
    attr_reader webview: Webview

    def initialize: (command: String, payload: Hash[String, json_value], responder: (^(bool, json_value) -> void)?, webview: Webview) -> void
    def resolve: (json_value value) -> void
    def reject: (json_value error) -> void
  end
end
