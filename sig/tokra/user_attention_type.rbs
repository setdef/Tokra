module Tokra
  class UserAttentionType < Data
    extend ClosedEnum
    include ClosedEnum::With

    attr_reader name: String

    private def self.new: (name: String) -> UserAttentionType
    def self.deserialize: (json_value value) -> UserAttentionType

    Critical: UserAttentionType
    Informational: UserAttentionType
  end
end
