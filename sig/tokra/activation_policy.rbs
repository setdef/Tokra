module Tokra
  class ActivationPolicy < Data
    extend ClosedEnum
    include ClosedEnum::With

    attr_reader name: String

    private def self.new: (name: String) -> ActivationPolicy

    Regular: ActivationPolicy
    Accessory: ActivationPolicy
    Prohibited: ActivationPolicy
  end

  class App
    def set_activation_policy: (ActivationPolicy activation_policy) -> nil
  end

  module Native
    class EventLoop
      def set_activation_policy: (String policy) -> void
    end
  end
end
