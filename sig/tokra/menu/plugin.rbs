module Tokra
  module Menu
    class Plugin < Tokra::Plugin
      type about_fields = Hash[Symbol, String | Array[String] | JsImage | nil]
      type payload = ExistingItem | PredefinedPayload | CheckPayload | IconPayload | SubmenuPayload | MenuItemPayload
      type icon = NativeIcon | JsImage

      class MenuChannels
        @mutex: Thread::Mutex
        @channels: Hash[MenuId, Ipc::Channel]

        def initialize: () -> void
        def insert: (MenuId id, Ipc::Channel channel) -> nil
        def get: (MenuId id) -> Ipc::Channel?
      end

      class Rejection < StandardError
      end

      UNREACHABLE: String
      UNWRAP_NONE: String
      ITEM_KINDS: Array[String]
      POSITION_VARIANTS: Array[String]
      PREDEFINED: Hash[String, Symbol]
      NATIVE_ICONS: Array[String]
      KIND_NAMES: Hash[Class, String]
      ALL_ITEMS: Array[String]
      ABOUT_FIELDS: Array[String]

      class ExistingItem < Data
        attr_reader rid: Integer
        attr_reader kind: String
        def self.new: (rid: Integer, kind: String) -> ExistingItem
      end

      class PredefinedPayload < Data
        attr_reader item: String
        attr_reader about: about_fields?
        attr_reader text: String?
        def self.new: (item: String, about: about_fields?, text: String?) -> PredefinedPayload
      end

      class CheckPayload < Data
        attr_reader handler: Ipc::JavaScriptChannelId?
        attr_reader id: MenuId?
        attr_reader text: String
        attr_reader checked: bool
        attr_reader enabled: bool?
        attr_reader accelerator: String?
        def self.new: (handler: Ipc::JavaScriptChannelId?, id: MenuId?, text: String, checked: bool, enabled: bool?,
                       accelerator: String?) -> CheckPayload
      end

      class IconPayload < Data
        attr_reader handler: Ipc::JavaScriptChannelId?
        attr_reader id: MenuId?
        attr_reader text: String
        attr_reader icon: icon
        attr_reader enabled: bool?
        attr_reader accelerator: String?
        def self.new: (handler: Ipc::JavaScriptChannelId?, id: MenuId?, text: String, icon: icon, enabled: bool?,
                       accelerator: String?) -> IconPayload
      end

      class SubmenuPayload < Data
        attr_reader id: MenuId?
        attr_reader text: String
        attr_reader enabled: bool?
        attr_reader items: Array[payload]
        attr_reader icon: icon?
        def self.new: (id: MenuId?, text: String, enabled: bool?, items: Array[payload], icon: icon?) -> SubmenuPayload
      end

      class MenuItemPayload < Data
        attr_reader handler: Ipc::JavaScriptChannelId?
        attr_reader id: MenuId?
        attr_reader text: String
        attr_reader enabled: bool?
        attr_reader accelerator: String?
        def self.new: (handler: Ipc::JavaScriptChannelId?, id: MenuId?, text: String, enabled: bool?,
                       accelerator: String?) -> MenuItemPayload
      end

      class NewOptions < Data
        attr_reader id: MenuId?
        attr_reader text: String?
        attr_reader enabled: bool?
        attr_reader checked: bool?
        attr_reader accelerator: String?
        attr_reader item: String?
        attr_reader about: about_fields?
        attr_reader icon: icon?
        attr_reader items: Array[payload]?
        def self.new: (id: MenuId?, text: String?, enabled: bool?, checked: bool?, accelerator: String?, item: String?,
                       about: about_fields?, icon: icon?, items: Array[payload]?) -> NewOptions
      end

      def name: () -> String
      def initialize: (AppHandle app, ?Hash[Symbol, String | Integer | Float | bool] config) -> void
      def on_event: (AppHandle app, run_event event) -> nil
      def extend_api: (Ipc::Invoke invoke) -> bool

      private

      def new_item: (Ipc::Invoke invoke) -> [Integer, String]
      def add_items: (Ipc::Invoke invoke, :append | :prepend operation) -> nil
      def insert_items: (Ipc::Invoke invoke) -> nil
      def remove_item: (Ipc::Invoke invoke) -> nil
      def remove_at: (Ipc::Invoke invoke) -> [Integer, String, String]?
      def list_items: (Ipc::Invoke invoke) -> Array[[Integer, String, String]]
      def get_item: (Ipc::Invoke invoke) -> [Integer, String, String]?
      def popup: (Ipc::Invoke invoke) -> nil
      def create_default: (Ipc::Invoke invoke) -> [Integer, String]
      def set_as_app_menu: (Ipc::Invoke invoke) -> [Integer, String]?
      def set_as_window_menu: (Ipc::Invoke invoke) -> [Integer, String]?
      def set_text: (Ipc::Invoke invoke) -> nil
      def set_enabled: (Ipc::Invoke invoke) -> nil
      def set_accelerator: (Ipc::Invoke invoke) -> nil
      def set_nsapp_menu: (Ipc::Invoke invoke) -> nil
      def set_icon: (Ipc::Invoke invoke) -> nil
      def set_checked: (Ipc::Invoke invoke) -> nil
      def check_item: (Ipc::Invoke invoke) -> CheckMenuItem
      def with_menu_item: [T] (Ipc::Invoke invoke, Array[String] kinds, ?after: (^() -> void)?) { (item) -> T } -> T
      def menu_or_submenu: (ResourceTable table, Integer rid, String kind) -> (Menu | Submenu)
      def menu_item: (ResourceTable table, Integer rid, String kind, Array[String] kinds) -> item
      def enableable: (item item) -> (MenuItem | Submenu | CheckMenuItem | IconMenuItem)
      def menu_resource: (ResourceTable table, Integer rid) -> Menu
      def submenu_resource: (ResourceTable table, Integer rid) -> Submenu
      def item_resource: (ResourceTable table, item item) -> [Integer, String, String]
      def with_item: [T] (Webview webview, ResourceTable table, payload payload) { (item) -> T } -> T
      def create_submenu: (Webview webview, ResourceTable table, SubmenuPayload payload) -> Submenu
      def create_check: (Webview webview, CheckPayload payload) -> CheckMenuItem
      def create_icon: (Webview webview, ResourceTable table, IconPayload payload) -> IconMenuItem
      def create_menu_item: (Webview webview, MenuItemPayload payload) -> MenuItem
      def create_predefined: (Webview webview, ResourceTable table, PredefinedPayload payload) -> PredefinedMenuItem
      def about_metadata_for: (ResourceTable table, about_fields fields) -> AboutMetadata
      def listen: [I < item] (Webview webview, I item, Ipc::JavaScriptChannelId? handler) -> I
      def channels: () -> MenuChannels
      def argument: (Ipc::Invoke invoke, String key) -> Ipc::CommandItem
      def rid_arg: (Ipc::Invoke invoke) -> Integer
      def kind_arg: (Ipc::Invoke invoke) -> String
      def mismatch: (String message) -> Ipc::CommandItem::Mismatch
      def string: (json_value value) -> String
      def boolean: (json_value value) -> bool
      def usize: (json_value value) -> Integer
      def menu_id: (json_value value) -> MenuId
      def unit_enum: (json_value value, Array[String] variants) -> String
      def enum_variant: (json_value value, Array[String] variants) -> [String, json_value]
      def known_variant: (String name, Array[String] variants) -> String
      def position: (json_value value) -> (LogicalPosition | PhysicalPosition)
      def position_fields: [T] (json_value value, String name) { (json_value field) -> T } -> [T, T]
      def f64: (json_value value) -> Float
      def item_kind: (json_value value) -> String
      def predefined: (json_value value) -> [String, about_fields?]
      def struct_fields: (json_value value, String name, Array[String] fields) -> Hash[String, json_value]
      def required: [T] (Hash[String, json_value] hash, String key) { (json_value) -> T } -> T
      def optional: [T] (Hash[String, json_value] hash, String key) { (json_value) -> T } -> T?
      def about_fields: (json_value value) -> about_fields
      def strings: (json_value value) -> Array[String]
      def channel_id: (json_value value) -> Ipc::JavaScriptChannelId
      def icon: (json_value value) -> icon
      def new_options: (json_value value) -> NewOptions
      def payload_kinds: (json_value value) -> Array[payload]
      def existing_item: (json_value value) -> [Integer, String]
      def payload_kind: (json_value value) -> payload
      def existing_payload: (json_value value) -> ExistingItem
      def predefined_payload: (json_value value) -> PredefinedPayload
      def check_payload: (json_value value) -> CheckPayload
      def icon_payload: (json_value value) -> IconPayload
      def submenu_payload: (json_value value) -> SubmenuPayload
      def menu_item_payload: (json_value value) -> MenuItemPayload
    end
  end
end
