module Tokra
  module Menu
    class PredefinedMenuItem
      include IsMenuItem

      def self.separator: (Manager manager) -> PredefinedMenuItem
      def self.copy: (Manager manager, String? text) -> PredefinedMenuItem
      def self.cut: (Manager manager, String? text) -> PredefinedMenuItem
      def self.paste: (Manager manager, String? text) -> PredefinedMenuItem
      def self.select_all: (Manager manager, String? text) -> PredefinedMenuItem
      def self.undo: (Manager manager, String? text) -> PredefinedMenuItem
      def self.redo: (Manager manager, String? text) -> PredefinedMenuItem
      def self.minimize: (Manager manager, String? text) -> PredefinedMenuItem
      def self.maximize: (Manager manager, String? text) -> PredefinedMenuItem
      def self.fullscreen: (Manager manager, String? text) -> PredefinedMenuItem
      def self.hide: (Manager manager, String? text) -> PredefinedMenuItem
      def self.hide_others: (Manager manager, String? text) -> PredefinedMenuItem
      def self.show_all: (Manager manager, String? text) -> PredefinedMenuItem
      def self.close_window: (Manager manager, String? text) -> PredefinedMenuItem
      def self.quit: (Manager manager, String? text) -> PredefinedMenuItem
      def self.about: (Manager manager, String? text, AboutMetadata? metadata) -> PredefinedMenuItem
      def self.services: (Manager manager, String? text) -> PredefinedMenuItem
      def self.from_native: (AppHandle app_handle, Native::PredefinedMenuItem native) -> PredefinedMenuItem
      def text: () -> String
      def set_text: (String text) -> nil

      private

      def self.build: (Manager manager, String kind, String? text, ?Native::PredefinedMenuItem::about? about) -> PredefinedMenuItem
    end
  end
end
