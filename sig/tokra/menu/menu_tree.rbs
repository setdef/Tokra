module Tokra
  module Menu
    module MenuTree : Wrapper
      def append: (item item) -> nil
      def append_items: (Array[item] items) -> nil
      def prepend: (item item) -> nil
      def prepend_items: (Array[item] items) -> nil
      def insert: (item item, Integer position) -> nil
      def insert_items: (Array[item] items, Integer position) -> nil
      def remove: (item item) -> nil
      def remove_at: (Integer position) -> item?
      def get: (MenuId | String id) -> item?
      def items: () -> Array[item]
    end
  end
end
