module Tokra
  class AppHandle
    include Manager

    @manager: AppManager
    @state_manager: StateManager?
    @runtime_context: RuntimeContext
    @restart_on_exit: bool
    @path: Path::Resolver?
    @resources_table: ResourceTable?

    @menu_manager: MenuManager
    @tray_manager: TrayManager

    def initialize: (AppManager manager, ?state_manager: StateManager?, ?runtime_context: RuntimeContext,
                     ?menu_event_listeners: Array[MenuManager::app_listener],
                     ?tray_icon_event_listeners: Array[TrayManager::app_listener]) -> void
    attr_reader menu_manager: MenuManager
    attr_reader tray_manager: TrayManager
    def on_tray_icon_event: () { (AppHandle, Tray::TrayIconEvent::event) -> void } -> nil
    def tray_by_id: (Tray::TrayIconId | String id) -> Tray::TrayIcon?
    def remove_tray_by_id: (Tray::TrayIconId | String id) -> Tray::TrayIcon?
    def cleanup_trays: () -> nil
    def on_menu_event: () { (AppHandle, Menu::MenuEvent) -> void } -> nil
    def menu: () -> Menu::Menu?
    def set_menu: (Menu::Menu menu) -> Menu::Menu?
    def remove_menu: () -> Menu::Menu?
    def hide_menu: () -> nil
    def show_menu: () -> nil
    def init_app_menu: (Menu::Menu menu) -> nil
    attr_reader runtime_context: RuntimeContext
    def run_on_main_thread: () { () -> void } -> nil
    def app_handle: -> AppHandle
    def config: -> Config
    def webviews: -> Hash[String, Webview]
    def windows: -> Hash[String, Window]
    def state: (Class klass) -> managed_state
    def try_state: (Class klass) -> managed_state?
    def manage: (Object state) -> bool
    def get_window: (String label) -> Window?
    def get_webview: (String label) -> Webview?
    def display_handle: () -> RawWindowHandle::display_handle
    def primary_monitor: () -> Monitor?
    def monitor_from_point: (Float | Integer x, Float | Integer y) -> Monitor?
    def available_monitors: () -> Array[Monitor]
    def cursor_position: () -> PhysicalPosition
    def resources_table: -> ResourceTable
    def plugin: (_Plugin plugin) -> bool
    def remove_plugin: (String name) -> bool
    def emit: (String event_name, ::_ToJson payload) -> void
    def exit: (?Integer code) -> nil
    def restart: () -> bot
    def request_restart: () -> nil
    def restart_on_exit?: () -> bool
    def path: -> Path::Resolver

    private

    def remove_menu_from_stash_by_id: (Menu::MenuId? id) -> nil
    def on_nsapp: () { () -> void } -> nil
    def window_target_getter: [T < Object] () { (Native::EventLoop) -> T? } -> T

    def manager: () -> AppManager
  end
end
