module Tokra
  class Monitor < Data
    attr_reader name: String?
    attr_reader size: PhysicalSize
    attr_reader position: PhysicalPosition
    attr_reader work_area: PhysicalRect
    attr_reader scale_factor: Float

    def self.new: (String? name, PhysicalSize size, PhysicalPosition position, PhysicalRect work_area, Float scale_factor) -> Monitor
                | (name: String?, size: PhysicalSize, position: PhysicalPosition, work_area: PhysicalRect, scale_factor: Float) -> Monitor
    def self.from_native: (Native::Window::monitor entry) -> Monitor
  end
end
