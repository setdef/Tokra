module Tokra
  class Image
    include Resource

    attr_reader rgba: String
    attr_reader width: Integer
    attr_reader height: Integer

    def self.new: (rgba: String, width: Integer, height: Integer) -> Image
                | (String rgba, Integer width, Integer height) -> Image
                  | (String rgba, Integer width, Integer height) -> void

    def self.from_bytes: (String bytes) -> Image
    NUL_IN_PATH: String

    def self.from_path: (String path) -> Image

    private def self.read: (String path) -> String
  end

  class JsImage
    MISMATCH: String
    U32_MAX: Integer

    @variant: String | Array[Integer] | Integer | Image

    def self.deserialize: (json_value value) -> JsImage

    private def self.new: (String | Array[Integer] | Integer | Image variant) -> JsImage
    private def self.rgba: (Hash[String, json_value] hash) -> Image?
    private def self.bytes: (Array[json_value] array) -> Array[Integer]?
    private def self.u32: (json_value value) -> Integer?

    def initialize: (String | Array[Integer] | Integer | Image variant) -> void
    def into_img: (ResourceTable resources_table) -> Image

    private

    def image_resource: (Integer rid, ResourceTable resources_table) -> Image
  end
end
