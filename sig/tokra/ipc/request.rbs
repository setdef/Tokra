module Tokra
  module Ipc
    class Request < Data
      attr_reader body: invoke_body
      attr_reader headers: Hash[String, String]

      def self.new: (body: invoke_body, headers: Hash[String, String]) -> Request
      def self.from_command: (Invoke invoke) -> Request
    end
  end
end
