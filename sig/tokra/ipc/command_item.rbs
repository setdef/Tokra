module Tokra
  module Ipc
    class CommandItem < Data
      class Mismatch < StandardError
        def self.invalid_type: (json_value value, String expected) -> Mismatch
      end

      INTEGERS: Hash[String, Range[Integer]]

      def self.integer: (json_value value, String type) -> Integer

      attr_reader name: String
      attr_reader key: String
      attr_reader payload: invoke_body

      def self.new: (name: String, key: String, payload: invoke_body) -> CommandItem

      def string: () -> String
      def u32: () -> Integer
      def strings: () -> Array[String]
      def deserialize: [T] () { (json_value value) -> T } -> T
      def deserialize_option: [T] () { (json_value value) -> T } -> T?

      private

      def arguments: () -> Hash[String, json_value]
      def string_value: (json_value item) -> String
    end
  end
end
