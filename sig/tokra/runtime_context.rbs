module Tokra
  # Runs window and webview work on the main thread, from any thread.
  class RuntimeContext
    PROXY_SCHEMES: Array[String]

    class Failure < Data
      attr_reader error: Exception
      def self.new: (error: Exception) -> Failure
    end

    @main_thread: Thread
    @mutex: Thread::Mutex
    @tasks: Array[[^() -> void, Thread::Queue[Object]?]]
    @proxy: Native::Proxy?
    @unsent: Array[^(Native::Proxy) -> void]
    @closed: bool
    @window_target: Native::EventLoop?
    @native: Module
    @menu_natives: Menu::Natives?
    @tray_natives: Tray::Natives?
    @open_windows: Array[String]

    def initialize: (?main_thread: Thread, ?native: Module) -> void
    def menu_natives: () -> Menu::Natives
    def tray_natives: () -> Tray::Natives
    def data_local_dir: () -> String?
    def run_main_thread: [T] () { () -> T } -> T
    attr_accessor window_target: Native::EventLoop?
    def main_thread?: () -> bool
    def attach: (Native::Proxy proxy) -> void
    def run_on_main_thread: () { () -> void } -> nil
    def getter: [T] () { () -> T } -> T
    def request_exit: (Integer code) -> nil
    def request_close: (String label) -> nil
    def handle_task: () -> nil
    def close: () -> nil
    def create_window: (String label, window_attributes: Hash[Symbol, Native::Window::attribute],
                        webview_attributes: Hash[Symbol, Native::WebView::attribute], url: String,
                        initialization_scripts: Array[Native::WebView::script], menu: Menu::Menu?) -> [Native::Window, Native::WebView]
    def window_destroyed: (String label) -> bool

    private

    def send_user_message: (^() -> void task, ?Thread::Queue[Object]? reply) -> nil
    def wake: (Native::Proxy? proxy) -> void
    def send_event: () { (Native::Proxy proxy) -> void } -> nil
    def send_through: (Native::Proxy? proxy) { (Native::Proxy proxy) -> void } -> void
    def call_and_wait: [T] (^() -> T query, Exception unanswered) -> T
    def answer: [T] ([T] | Failure | nil reply, Exception unanswered) -> T
    def init_window_menu: (Native::Window native_window, Menu::Menu menu, String theme) -> void
    def open_window: (Native::Window native_window, String label, Hash[Symbol, Native::Window::attribute] attributes, Menu::Menu? menu) -> bool
    def open_webview: (Native::Window native_window, Native::WebView native_webview, Native::Proxy proxy, String label, String url, Array[Native::WebView::script] initialization_scripts, Hash[Symbol, Native::WebView::attribute] attributes) -> void
  end
end
