module Tokra
  class ProgressBarStatus < Data
    extend ClosedEnum
    include ClosedEnum::With

    attr_reader name: String

    private def self.new: (name: String) -> ProgressBarStatus
    def self.deserialize: (json_value value) -> ProgressBarStatus

    VARIANTS: Array[ProgressBarStatus]

    None: ProgressBarStatus
    Normal: ProgressBarStatus
    Indeterminate: ProgressBarStatus
    Paused: ProgressBarStatus
    Error: ProgressBarStatus
  end
end
