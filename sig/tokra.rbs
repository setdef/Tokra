# Tokra module types - global definitions and type aliases.
# Individual class/module types are in sig/tokra/*.rbs files.

module Tokra
  VERSION: String

  # Recursive type alias for JSON values.
  # Matches serde_json::Value semantics from Tauri's IPC protocol.
  type json_value = String | Integer | Float | bool | nil | Array[json_value] | Hash[String, json_value]

  # Type alias for all native events dispatched by event loop
  type native_event = Native::HttpRequestEvent | Native::IpcEvent | Native::PageLoadEvent | Native::WindowCloseEvent | Native::WakeUpEvent

  def self.generate_invoke_key: () -> String

  class Error < StandardError
  end
end
