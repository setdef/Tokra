module Tokra
  VERSION: String

  type json_value = String | Integer | Float | bool | nil | Array[json_value] | Hash[String, json_value]

  type native_event = Native::HttpRequestEvent | Native::IpcEvent | Native::PageLoadEvent | Native::WindowCloseEvent | Native::WindowDestroyedEvent | Native::ExitRequestedEvent | Native::WakeUpEvent | Native::DragDropEvent | Native::WebviewFocusedEvent | Native::WindowResizedEvent | Native::WindowMovedEvent | Native::WindowFocusedEvent | Native::WindowScaleFactorChangedEvent | Native::WindowThemeChangedEvent | Native::LoopDestroyedEvent | Native::TaskEvent | Native::MenuEvent

  type invoke_body = json_value

  type ipc_responder = ^(bool success, String body) -> void

  def self.generate_invoke_key: () -> String
  def self.generate_context: (?(String | Pathname)? path) -> Context
  private def self.given_config_file: (String path) -> String
  def self.anchor: () -> String
  def self.script_name: () -> String
  def self.record_anchor: (?String program) -> String

  self.@anchor: String
  self.@script_name: String

  class Error < StandardError
  end
end
