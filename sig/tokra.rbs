module Tokra
  VERSION: String
  class Error < StandardError
  end


  # Native extension classes (implemented in Rust via Magnus)
  module Native
    class EventLoop
      def initialize: () -> void
      def create_proxy: () -> Proxy
      def run: (^(HttpRequestEvent | IpcEvent | WakeUpEvent | WindowCloseEvent | PageLoadEvent) -> void) -> void
    end

    class Window
      def initialize: (EventLoop) -> void
      def set_title: (String) -> void
      def set_size: (Float, Float) -> void
    end

    class WebView
      def self.new_with_protocol: (Window, Proxy) -> WebView
      def initialize: (Window, String, ^(String) -> void, Proxy) -> void
      def eval: (String) -> void
    end

    class Proxy
      def respond: (Integer, Integer, Array[Array[String]], String) -> void
      def send_http_response: (Integer, Integer, Hash[String, String], String) -> void
    end

    class HttpRequestEvent
      def request_id: () -> Integer
      def method: () -> String
      def uri: () -> String
      def headers: () -> Array[[String, String]]
      def body: () -> String
    end

    class IpcEvent
      def message: () -> String
    end

    class WakeUpEvent
    end

    class WindowCloseEvent
    end

    class PageLoadEvent
      def event: () -> String
      def url: () -> String
      def started?: () -> bool
      def finished?: () -> bool
    end

    # Generates JavaScript code to emit an event to the WebView.
    def self.emit_js_script: (String event, String payload) -> String

    # Loads a JS template from lib/tokra/js/.
    def self.load_js_template: (String name) -> String

    # Drag drop event from native layer.
    # Data.define(:event, :paths, :x, :y)
    class DragDropEvent < Data
      def event: () -> String
      def paths: () -> Array[String]
      def x: () -> Integer
      def y: () -> Integer
      def self.new: (String, Array[String], Integer, Integer) -> DragDropEvent
    end

    # Path resolution functions from dirs crate.
    def self.home_dir: () -> String
    def self.data_local_dir: () -> String
  end

  # HTTP response for URI scheme protocol handlers.
  # Created via Data.define(:status, :headers, :body)
  class Response < Data
    attr_reader status: Integer
    attr_reader headers: Hash[String, String]
    attr_reader body: String

    def self.new: (status: Integer, headers: Hash[String, String], body: String) -> Response
    def self.ok: (String body, ?content_type: String) -> Response
    def self.not_found: (?String message) -> Response
    def self.error: (Integer status, String message) -> Response
  end

  # Context passed to URI scheme protocol handlers.
  # Created via Data.define(:app_handle, :webview_label)
  class UriSchemeContext < Data
    attr_reader app_handle: AppHandle
    attr_reader webview_label: String

    def self.new: (app_handle: AppHandle, webview_label: String) -> UriSchemeContext
  end

  # Single-use responder for async URI scheme protocol handlers.
  class UriSchemeResponder
    @responded: bool
    attr_reader port: Native::Proxy
    attr_reader request_id: Integer

    def initialize: (port: Native::Proxy, request_id: Integer) -> void
    def respond: (Response response) -> void
  end

  # Type alias for managed state values (type-erased storage)
  type managed_state = Object

  # Manages application state by type.
  class StateManager
    @map: Hash[Class, managed_state]

    def initialize: () -> void
    def set: (managed_state state) -> bool
    def get: (Class klass) -> managed_state
    def try_get: (Class klass) -> managed_state?
  end

  # Application configuration
  class Config < Data
    attr_reader identifier: String?
    attr_reader product_name: String?
    attr_reader version: String?

    def self.new: (identifier: String?, product_name: String?, version: String?) -> Config
  end

  # Internal manager for application state
  class AppManager < Data
    attr_reader config: Config
    attr_reader webviews: Hash[String, Native::WebView]

    def self.new: (config: Config, webviews: Hash[String, Native::WebView]) -> AppManager
  end

  # Handle to the running application, safe to pass between Ractors.
  class AppHandle
    @manager: AppManager
    @state_manager: StateManager?
    @path: Path::Resolver?

    def initialize: (AppManager manager, ?state_manager: StateManager?) -> void
    def app_handle: -> AppHandle
    def config: -> Config
    def webviews: -> Hash[String, Native::WebView]
    def state: (Class klass) -> managed_state
    def try_state: (Class klass) -> managed_state?
    def manage: (Object state) -> bool
    def get_window: (String label) -> Native::Window?
    def get_webview: (String label) -> Native::WebView?
    def windows: -> Hash[String, Native::Window]
    def emit: (String event_name, ::_ToJson payload) -> void
    def exit: (?Integer code) -> void
    def path: -> Path::Resolver

  end

  # The built Tokra application.
  class App
    DEFAULT_CONFIG: Hash[Symbol, String | Integer | Float]

    @config: Hash[Symbol, String | Integer | Float]
    @handle: AppHandle
    @builder: Builder
    @event_loop_class: singleton(Native::EventLoop)
    @window_class: singleton(Native::Window)
    @webview_class: singleton(Native::WebView)

    attr_reader handle: AppHandle
    attr_reader config: Hash[Symbol, String | Integer | Float]

    def initialize: (Builder builder, ?native: Module) -> void
    def run: () { (AppHandle, run_event) -> void } -> void
         | () -> void

    private

    def dispatch_event: (native_event event, (^(AppHandle, run_event) -> void)? callback, Native::Window window, Native::Proxy proxy) -> void
    def dispatch_http_request: (Native::HttpRequestEvent event, Native::Proxy proxy) -> void
    def dispatch_ipc: (Native::IpcEvent event) -> void
    def dispatch_page_load: (Native::PageLoadEvent event) -> void
    def dispatch_window_event: (Native::Window window, window_event event, (^(AppHandle, run_event) -> void)? callback) -> void
    def dispatch_webview_event: (Native::DragDropEvent native_event) -> void
  end

  # Invoke object for IPC commands.
  class Invoke
    @command: String
    @payload: String
    @responder: (^(bool, String) -> void)?
    @responded: bool

    attr_reader command: String
    attr_reader payload: String

    def initialize: (command: String, payload: String, responder: (^(bool, String) -> void)?) -> void
    def resolve: (String value) -> void
    def reject: (String error) -> void
  end

  # Window event types dispatched to on_window_event callbacks.
  # Each is a Data.define class.
  module WindowEvent
    class CloseRequested < Data
    end
    class Destroyed < Data
    end
    class Focused < Data
      attr_reader focused: bool
    end
    class Moved < Data
      attr_reader x: Integer
      attr_reader y: Integer
    end
    class Resized < Data
      attr_reader width: Integer
      attr_reader height: Integer
    end
    class ScaleFactorChanged < Data
      attr_reader scale_factor: Float
    end
    class ThemeChanged < Data
      attr_reader theme: String
    end
  end

  # A position in physical (pixel) coordinates.
  class PhysicalPosition < Data
    attr_reader x: Integer
    attr_reader y: Integer
    def self.new: (Integer, Integer) -> PhysicalPosition
  end

  # Drag and drop event types.
  module DragDropEvent
    class Enter < Data
      attr_reader paths: Array[Pathname]
      attr_reader position: PhysicalPosition
      def self.new: (Array[Pathname], PhysicalPosition) -> Enter
    end
    class Over < Data
      attr_reader position: PhysicalPosition
      def self.new: (PhysicalPosition) -> Over
    end
    class Drop < Data
      attr_reader paths: Array[Pathname]
      attr_reader position: PhysicalPosition
      def self.new: (Array[Pathname], PhysicalPosition) -> Drop
    end
    class Leave < Data
      def self.new: () -> Leave
    end
  end

  # Type alias for drag drop events
  type drag_drop_event = DragDropEvent::Enter | DragDropEvent::Over | DragDropEvent::Drop | DragDropEvent::Leave

  # Webview event types.
  module WebviewEvent
    class DragDrop < Data
      attr_reader event: drag_drop_event
      def self.new: (drag_drop_event) -> DragDrop
    end
  end

  # Page load payload passed to on_page_load callbacks.
  # Created via Data.define(:url, :started)
  class PageLoadPayload < Data
    attr_reader url: String
    attr_reader started: bool

    def self.new: (url: String, started: bool) -> PageLoadPayload
    def started?: () -> bool
    def finished?: () -> bool
  end

  # Run event types dispatched during app.run.
  # Each is a Data.define class.
  module RunEvent
    class Ready < Data
      def self.new: () -> Ready
    end
    class Exit < Data
      def self.new: () -> Exit
    end
    class ExitRequested < Data
      attr_reader code: Integer?
      def self.new: (?code: Integer?) -> ExitRequested
    end
    class WindowEvent < Data
      attr_reader label: String
      attr_reader event: Tokra::window_event
      def self.new: (label: String, event: Tokra::window_event) -> WindowEvent
    end
    class WebviewEvent < Data
      attr_reader label: String
      attr_reader event: Object
      def self.new: (label: String, event: Object) -> WebviewEvent
    end
    class Resumed < Data
      def self.new: () -> Resumed
    end
    class MainEventsCleared < Data
      def self.new: () -> MainEventsCleared
    end
  end

  # Type alias for all native events dispatched by event loop
  type native_event = Native::HttpRequestEvent | Native::IpcEvent | Native::PageLoadEvent | Native::WindowCloseEvent | Native::WakeUpEvent

  # Type alias for window events
  type window_event = WindowEvent::CloseRequested | WindowEvent::Destroyed | WindowEvent::Focused | WindowEvent::Moved | WindowEvent::Resized | WindowEvent::ScaleFactorChanged | WindowEvent::ThemeChanged

  # Type alias for webview events
  type webview_event = WebviewEvent::DragDrop

  # Type alias for run events
  type run_event = RunEvent::Ready | RunEvent::Exit | RunEvent::ExitRequested | RunEvent::WindowEvent | RunEvent::WebviewEvent | RunEvent::Resumed | RunEvent::MainEventsCleared

  # Fluent Builder for configuring Tokra desktop applications.
  class Builder
    @invoke_handler: (^(Invoke) -> bool)?
    @uri_scheme_protocols: Hash[String, ^(UriSchemeContext, Native::HttpRequestEvent) -> Response]
    @setup: (^(App) -> void)?
    @on_page_load: (^(Native::WebView?, PageLoadPayload) -> void)?
    @window_event_listeners: Array[^(Native::Window, window_event) -> void]
    @webview_event_listeners: Array[^(Native::WebView?, webview_event) -> void]
    @state_manager: StateManager

    def initialize: () -> void
    def self.default: () -> Builder
    def manage: (managed_state state) -> self
    def invoke_handler: () { (Invoke) -> bool } -> self
    def register_uri_scheme_protocol: (String uri_scheme) { (UriSchemeContext, Native::HttpRequestEvent) -> Response } -> self
    def register_asynchronous_uri_scheme_protocol: (String uri_scheme) { (UriSchemeContext, Native::HttpRequestEvent, UriSchemeResponder) -> void } -> self
    def setup: () { (App) -> void } -> self
    def on_page_load: () { (Native::WebView?, PageLoadPayload) -> void } -> self
    def on_window_event: () { (Native::Window, window_event) -> void } -> self
    def on_webview_event: () { (Native::WebView?, webview_event) -> void } -> self
    def build: (?native: Module) -> App
    def run: (?native: Module) ?{ (AppHandle, run_event) -> void } -> void

    private

    attr_reader invoke_handler_hook: (^(Invoke) -> bool)?
    attr_reader uri_scheme_protocols: Hash[String, ^(UriSchemeContext, Native::HttpRequestEvent) -> Response]
    attr_reader async_uri_scheme_protocols: Hash[String, ^(UriSchemeContext, Native::HttpRequestEvent, UriSchemeResponder) -> void]
    attr_reader setup_hook: (^(App) -> void)?
    attr_reader on_page_load_hook: (^(Native::WebView?, PageLoadPayload) -> void)?
    attr_reader window_event_listeners: Array[^(Native::Window, window_event) -> void]
    attr_reader webview_event_listeners: Array[^(Native::WebView?, webview_event) -> void]
    attr_reader state_manager: StateManager

    private def require_shareable!: (Proc block, String method_name) -> void
  end
end

# Rack types based on Rack 3.x spec
module Rack
  type env = Hash[String, (String | Integer | Array[Integer] | IO | bool | nil | StringIO)]
  type headers = Hash[String, String]
  type status = Integer

  # Rack body - any object that responds to each yielding strings
  # We use Object as base to get respond_to? and other Object methods
  class Body < Object
    def each: () { (String) -> void } -> void
    def close: () -> void
    # Optional: Array-style bodies
    def to_ary: () -> Array[String]
    # Optional: File path for sendfile optimization
    def to_path: () -> String
  end

  type response = [status, headers, Body]

  interface _App
    def call: (env) -> response
  end

  module Handler
    class Tokra
      MAX_REDIRECTS: Integer
      DEFAULT_OPTIONS: { title: String, width: Float, height: Float }

      @app: Rack::_App
      @proxy: ::Tokra::Native::Proxy

      def self.run: (Rack::_App app, ?title: String, ?width: Float, ?height: Float, ?invoke_handler: (^(String) -> void)?) -> void

      def initialize: (Rack::_App app, ::Tokra::Native::Proxy proxy) -> void
      def call: (::Tokra::Native::HttpRequestEvent event) -> void

      private

      def build_env: (URI::Generic uri, String method, String body, ?::Tokra::Native::HttpRequestEvent? event, ?String? cookies) -> Rack::env
      def respond_with_error: (Integer request_id, Integer status, String message) -> void
    end
  end
end
