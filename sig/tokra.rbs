module Tokra
  VERSION: String

  type json_value = String | Integer | Float | bool | nil | Array[json_value] | Hash[String, json_value]

  type native_event = Native::HttpRequestEvent | Native::IpcEvent | Native::PageLoadEvent | Native::WindowCloseEvent | Native::WindowDestroyedEvent | Native::ExitRequestedEvent | Native::WakeUpEvent | Native::DragDropEvent | Native::LoopDestroyedEvent | Native::TaskEvent

  type invoke_body = json_value

  type ipc_responder = ^(bool success, String body) -> void

  def self.generate_invoke_key: () -> String

  class Error < StandardError
  end
end
