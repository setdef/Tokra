@@ -1926,6 +1926,18 @@ use ::rb_sys::{
 };
 pub use magnus_macros::{DataTypeFunctions, TypedData, init, wrap};
 
+/// The C type of the lengths and indices Ruby's API takes and returns, such
+/// as a String's length or an Array's index.
+///
+/// Ruby 4.1 names it `rb_len_t`. It is `long`, except where Ruby is built
+/// with `SIZEOF_RB_LEN_T` wider than `long`, as on 64-bit mswin and
+/// RubyInstaller's MinGW builds, where `long` is 32 bits and `rb_len_t` is
+/// 64. Earlier Rubies take `long`.
+#[cfg(ruby_gte_4_1)]
+pub(crate) type Len = ::rb_sys::rb_len_t;
+#[cfg(ruby_lt_4_1)]
+pub(crate) type Len = std::ffi::c_long;
+
 #[cfg(feature = "fiber")]
 #[cfg_attr(docsrs, doc(cfg(feature = "fiber")))]
 pub use crate::fiber::Fiber;
