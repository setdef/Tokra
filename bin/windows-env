# Runs a command on Windows with what Rust needs to build Tokra for
# RubyInstaller's Ruby, as CI's Windows job sets it
# (.github/workflows/ci.yml): tasks/setup.rb runs bundle install through
# it, and .githooks/pre-push the gate. Run anything else the same way,
# from cmd.exe, PowerShell, or bash, through mise, which a file with no
# extension needs for Ruby to start it:
#
#   mise x -- ruby bin/windows-env bundle exec rake test:core
#
# See tasks/windows_env.rb.

require_relative "../tasks/windows_env"

$stdout.sync = true
exit WindowsEnv.new(checkout: File.expand_path("..", __dir__)).call(ARGV)
