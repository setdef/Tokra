# Tokra's development tools and git hooks, from the pins in mise.toml:
# the two lines below, which are all you need to type in any shell (cmd and
# Windows PowerShell run bin/setup.cmd, or take the two lines as they are).
# Everything it does is in tasks/setup.rb. The first run on a clean machine
# installs Ruby, Rust, and Python, and takes minutes.
cd "$(dirname "$0")/.." || exit 1
mise trust -q mise.toml
exec mise x -- ruby tasks/setup.rb "$@"
