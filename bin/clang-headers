# Puts clang's own headers in Tokra's folder of your cache, for bindgen on
# Windows. tasks/setup.rb runs it there, and bin/windows-env points
# bindgen at what it unpacks. On Windows, run it through mise, as every
# Ruby file there:
#
#   mise x -- ruby bin/clang-headers
#
# See tasks/clang_headers.rb.

require_relative "../tasks/clang_headers"

$stdout.sync = true
exit ClangHeaders.new(env: ENV).call
