#
# Runs the gate, bundle exec rake, before a push that changes a branch, so
# a commit that would turn CI red stops here. bin/setup writes a stub into
# the clone's hooks folder that runs this file. git passes the remote's
# name and URL as arguments and one line for each ref on standard input.
#
# The gate tests the working tree, so the push is refused unless that is
# the commit being pushed, with nothing uncommitted and nothing untracked.
# Then the hook sets Tokra up itself, so it needs nothing run before it,
# not even in a fresh checkout: only mise. On Linux the gate runs as CI
# runs it (.github/workflows/ci.yml), under Xvfb and a D-Bus session of
# its own, so its windows open on no one's desktop. On Windows it runs
# from MSYS2's bash, as CI's Windows job does.
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
# git points a hook's commands at its own repository through these, from a
# worktree above all. A test in the gate that makes a repository of its own
# would then write into yours, so every git below finds its repository
# from the folder it runs in instead.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR

zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD) || exit 1
gate=no
while read -r _local_ref local_sha remote_ref _remote_sha; do
  # Only a branch that moves needs the gate: not a tag, and not a deletion.
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  [ "$local_sha" = "$zero" ] && continue
  if [ "$local_sha" != "$head" ]; then
    echo "pre-push: $remote_ref would get $local_sha, but the working tree is at $head." >&2
    echo "pre-push: the gate tests the working tree, so check out the commit you push." >&2
    exit 1
  fi
  gate=yes
done
[ "$gate" = yes ] || exit 0

if ! git diff --quiet HEAD --; then
  echo "pre-push: the working tree has uncommitted changes, which the gate would test in place of" >&2
  echo "pre-push: the commit you push. Commit or stash them, then push again." >&2
  exit 1
fi
# The tests and the compiler read files git does not track, so one you
# forgot to add would pass here and be missing from the push.
untracked=$(git ls-files --others --exclude-standard) || exit 1
if [ -n "$untracked" ]; then
  echo "pre-push: the working tree has files git does not track, which the gate would read though" >&2
  echo "pre-push: the push leaves them behind. Add, remove, or ignore them, then push again:" >&2
  echo "$untracked" >&2
  exit 1
fi

# bin/setup --gate installs the tools mise.toml pins and the bundle, and on
# Linux the packages the machine lacks, and does nothing when they are
# there. It leaves the git hooks and the RDoc to a person's bin/setup.
# What it prints goes to a log, and its end to you if it fails.
log=tmp/pre-push-setup.log
mkdir -p tmp || exit 1
bin/setup --gate > "$log" 2>&1 || {
  status=$?
  tail -n 40 "$log" >&2
  echo "pre-push: bin/setup --gate failed with status $status; all it printed is in $log." >&2
  exit "$status"
}

# Nothing need have activated mise, so the gate runs with the tools it
# pins through mise x.
#
# Windows sets OS for every process, and MSYS2's bash passes it on.
# bin/windows-env sets what CI's earlier steps set for Rust and bindgen,
# and A and RUST_BACKTRACE are the gate step's own on Windows: each test
# prints its name, and a Rust panic its backtrace.
if [ "${OS:-}" = Windows_NT ]; then
  A=--verbose
  RUST_BACKTRACE=1
  export A RUST_BACKTRACE
  exec mise x -- sh bin/windows-env bundle exec rake
fi
case "$(uname -s)" in
  Linux)
    # GTK takes a Wayland desktop before the X display xvfb-run gives it.
    unset WAYLAND_DISPLAY
    GDK_BACKEND=x11
    export GDK_BACKEND
    # bin/linux-env brings ci.yml's packages where they are missing.
    exec mise x -- bin/linux-env xvfb-run --auto-servernum dbus-run-session -- bundle exec rake ;;
  *) exec mise x -- bundle exec rake ;;
esac
